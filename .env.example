# Секреты. Не коммитьте .env в git.
TELEGRAM_BOT_TOKEN=123456:replace-me
# Ваш числовой Telegram id (узнать: @userinfobot). Бот отвечает только ему.
TELEGRAM_OWNER_ID=123456789

# --- Docker compose ---------------------------------------------------------
# Пароль только из букв и цифр: он подставляется в строку подключения как есть.
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=tsu_bot
# POSTGRES_DB=tsu_bot

# --- Запуск без Docker ------------------------------------------------------
# В compose эта переменная не используется, строка собирается из POSTGRES_*.
DATABASE_URL=postgresql://tsu_bot:change-me@localhost:5432/tsu_bot

# Необязательно
# CONFIG_PATH=config.yaml
# LOG_LEVEL=INFO
